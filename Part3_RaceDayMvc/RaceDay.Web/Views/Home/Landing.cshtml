@{
    ViewData["Title"] = "Run, walk and cycle events";
}
<section class="rd-hero">
    <div class="container rd-hero-inner">
        <div class="row align-items-center g-5">
            <div class="col-lg-7">
                <h1>Every finish line starts with a number on your chest.</h1>
                <p class="lead mt-3">Find a run, walk or ride, pick your category, and see your name on the results board when you cross the line.</p>
                <div class="d-flex flex-wrap gap-2 mt-4">
                    <a class="btn btn-primary btn-lg" asp-controller="Account" asp-action="Register">Create an account</a>
                    <a class="btn btn-outline-light btn-lg" asp-controller="Account" asp-action="Login">Log in</a>
                </div>
            </div>
            <div class="col-lg-5">
                <div class="rd-bib" aria-hidden="true">
                    <div class="rd-bib-brand"><span>RACEDAY</span><span>10K</span></div>
                    <div class="rd-bib-number">1042</div>
                    <div class="rd-bib-foot"><span>Sea Point Sunrise</span><span>Senior</span></div>
                </div>
            </div>
        </div>
    </div>
</section>

<section class="rd-page">
    <div class="container">
        <div class="rd-split">
            <div class="rd-card"><div class="rd-card-body">
                <h2 class="rd-card-title">Racing it</h2>
                <ul>
                    <li>Browse upcoming events and filter by run, walk or cycle.</li>
                    <li>Enrol in the age or distance category that suits you.</li>
                    <li>Follow your enrolment status from pending to confirmed.</li>
                    <li>Keep your race history: finish time and finishing position.</li>
                </ul>
            </div></div>
            <div class="rd-card"><div class="rd-card-body">
                <h2 class="rd-card-title">Running it</h2>
                <ul>
                    <li>Create events with a banner image and categories.</li>
                    <li>See enrolments per event and confirm each entry.</li>
                    <li>Capture finish times and publish results after the race.</li>
                    <li>Keep an eye on upcoming dates from your dashboard.</li>
                </ul>
            </div></div>
        </div>
    </div>
</section>
