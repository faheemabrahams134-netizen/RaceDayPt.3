@model EventFormViewModel
@{
    var editing = Model.EventId.HasValue;
    ViewData["Title"] = editing ? "Edit event" : "New event";
}
<div class="container rd-page">
    <div class="rd-crumb"><a asp-action="Index"><i class="bi bi-arrow-left"></i> Manage events</a></div>
    <div class="rd-page-head"><h1>@ViewData["Title"]</h1></div>

    <div class="rd-card"><div class="rd-card-body">
        <form asp-action="@(editing ? "Edit" : "Create")" asp-route-id="@Model.EventId" method="post" enctype="multipart/form-data" novalidate>
            <input type="hidden" asp-for="ExistingBannerVersion" />
            <div asp-validation-summary="ModelOnly" class="rd-alert rd-alert-error mb-3"></div>
            <div class="row g-3">
                <div class="col-md-8">
                    <label asp-for="Name" class="form-label"></label>
                    <input asp-for="Name" class="form-control" />
                    <span asp-validation-for="Name" class="text-danger"></span>
                </div>
                <div class="col-md-4">
                    <label asp-for="EventType" class="form-label"></label>
                    <select asp-for="EventType" class="form-select" asp-items="Html.GetEnumSelectList<EventType>()">
                        <option value="">Select a type</option>
                    </select>
                    <span asp-validation-for="EventType" class="text-danger"></span>
                </div>
                <div class="col-12">
                    <label asp-for="Description" class="form-label"></label>
                    <textarea asp-for="Description" class="form-control" rows="4"></textarea>
                    <span asp-validation-for="Description" class="text-danger"></span>
                </div>
                <div class="col-md-4">
                    <label asp-for="EventDate" class="form-label"></label>
                    <input asp-for="EventDate" type="datetime-local" class="form-control" value="@(Model.EventDate?.ToString("yyyy-MM-ddTHH:mm"))" />
                    <span asp-validation-for="EventDate" class="text-danger"></span>
                </div>
                <div class="col-md-5">
                    <label asp-for="Location" class="form-label"></label>
                    <input asp-for="Location" class="form-control" />
                    <span asp-validation-for="Location" class="text-danger"></span>
                </div>
                <div class="col-md-3">
                    <label asp-for="DistanceKm" class="form-label"></label>
                    <input asp-for="DistanceKm" type="number" step="0.1" min="0.1" class="form-control" />
                    <span asp-validation-for="DistanceKm" class="text-danger"></span>
                </div>
                <div class="col-12">
                    <label asp-for="Banner" class="form-label"></label>
                    @if (Model.ExistingBannerVersion is not null && Model.EventId is { } id)
                    {
                        <div class="mb-2">
                            <img class="rd-detail-banner" style="max-height:160px;max-width:320px" alt="Current banner" src="@Url.Action("EventBanner", "Media", new { id, v = Model.ExistingBannerVersion })" />
                            <div class="form-text">Current banner. Choose a new file to replace it.</div>
                        </div>
                    }
                    <input asp-for="Banner" type="file" class="form-control" accept="image/png,image/jpeg,image/gif,image/webp" data-preview="banner-preview" />
                    <div class="form-text">JPG, PNG, GIF or WebP, up to 5 MB. Wide images (about 16:7) look best.</div>
                    <div id="banner-preview-warn" class="text-danger small" role="alert"></div>
                    <span asp-validation-for="Banner" class="text-danger"></span>
                    <img id="banner-preview" class="rd-detail-banner d-none mt-2" style="max-height:160px;max-width:320px" alt="Preview of the chosen banner" />
                </div>
            </div>
            <div class="d-flex gap-2 mt-4">
                <button type="submit" class="btn btn-primary">@(editing ? "Save changes" : "Create event")</button>
                <a class="btn btn-outline-ink" asp-action="Index">Cancel</a>
            </div>
        </form>
    </div></div>
</div>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
