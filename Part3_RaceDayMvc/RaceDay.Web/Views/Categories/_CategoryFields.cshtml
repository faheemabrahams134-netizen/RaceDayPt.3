@model CategoryFormViewModel
<div class="row g-3">
    <div class="col-md-6">
        <label asp-for="Name" class="form-label"></label>
        <input asp-for="Name" class="form-control" placeholder="e.g. Under 20, Senior, 10km" />
        <span asp-validation-for="Name" class="text-danger"></span>
    </div>
    <div class="col-md-6">
        <label asp-for="CategoryType" class="form-label"></label>
        <select asp-for="CategoryType" class="form-select" data-toggle-fields asp-items="Html.GetEnumSelectList<CategoryType>()">
            <option value="">Select a type</option>
        </select>
        <span asp-validation-for="CategoryType" class="text-danger"></span>
    </div>
    <div class="col-12">
        <label asp-for="Description" class="form-label"></label>
        <input asp-for="Description" class="form-control" />
        <span asp-validation-for="Description" class="text-danger"></span>
    </div>
    <div class="col-6 d-none" data-show-when="Age">
        <label asp-for="MinAge" class="form-label"></label>
        <input asp-for="MinAge" type="number" min="0" max="120" class="form-control" />
        <span asp-validation-for="MinAge" class="text-danger"></span>
    </div>
    <div class="col-6 d-none" data-show-when="Age">
        <label asp-for="MaxAge" class="form-label"></label>
        <input asp-for="MaxAge" type="number" min="0" max="120" class="form-control" />
        <span asp-validation-for="MaxAge" class="text-danger"></span>
    </div>
    <div class="col-12 d-none" data-show-when="Distance">
        <label asp-for="DistanceKm" class="form-label"></label>
        <input asp-for="DistanceKm" type="number" step="0.1" min="0.1" class="form-control" />
        <span asp-validation-for="DistanceKm" class="text-danger"></span>
    </div>
</div>
