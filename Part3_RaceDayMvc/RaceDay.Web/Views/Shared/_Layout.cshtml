@functions {
    private string Active(string controller, string? action = null)
    {
        var c = ViewContext.RouteData.Values["controller"]?.ToString();
        var a = ViewContext.RouteData.Values["action"]?.ToString();
        var on = string.Equals(c, controller, StringComparison.OrdinalIgnoreCase)
                 && (action is null || string.Equals(a, action, StringComparison.OrdinalIgnoreCase));
        return on ? "active" : "";
    }
}
@{
    var pageTitle = ViewData["Title"] as string;
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@(string.IsNullOrEmpty(pageTitle) ? "RaceDay" : pageTitle + " | RaceDay")</title>
    <link rel="icon" type="image/svg+xml" href="~/favicon.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Barlow+Condensed:wght@600;700&family=Barlow:wght@400;500;600;700&display=swap" rel="stylesheet" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" rel="stylesheet" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
<header>
    <nav class="navbar navbar-expand-lg rd-nav" aria-label="Main navigation">
        <div class="container">
            <a class="navbar-brand" asp-controller="Home" asp-action="Index">
                <span class="rd-brand-mark"><i class="bi bi-flag-fill"></i></span>RaceDay
            </a>
            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#mainNav"
                    aria-controls="mainNav" aria-expanded="false" aria-label="Toggle navigation">
                <span class="navbar-toggler-icon"></span>
            </button>
            <div class="collapse navbar-collapse" id="mainNav">
                <ul class="navbar-nav me-auto mb-2 mb-lg-0">
                    @if (Me.IsParticipant)
                    {
                        <li class="nav-item"><a class="nav-link @(Active("Home") + Active("Events"))" asp-controller="Home" asp-action="Index">Events</a></li>
                        <li class="nav-item"><a class="nav-link @Active("Participant", "Enrolments")" asp-controller="Participant" asp-action="Enrolments">My Enrolments</a></li>
                        <li class="nav-item"><a class="nav-link @Active("Participant", "Results")" asp-controller="Participant" asp-action="Results">My Results</a></li>
                    }
                    else if (Me.IsOrganiser)
                    {
                        <li class="nav-item"><a class="nav-link @Active("Organiser")" asp-controller="Organiser" asp-action="Dashboard">Dashboard</a></li>
                        <li class="nav-item"><a class="nav-link @(Active("ManageEvents") + Active("Categories") + Active("Enrolments") + Active("Results"))" asp-controller="ManageEvents" asp-action="Index">Manage Events</a></li>
                    }
                </ul>
                <div class="d-flex align-items-lg-center flex-column flex-lg-row gap-2 gap-lg-3">
                    @if (Me.IsAuthenticated)
                    {
                        <a class="rd-user text-decoration-none" asp-controller="Account" asp-action="Profile" title="Your profile">
                            @if (Me.Current!.PictureVersion is not null)
                            {
                                <img class="rd-avatar" alt="" src="@Url.Action("ProfilePicture", "Media", new { v = Me.Current.PictureVersion })" />
                            }
                            else
                            {
                                <span class="rd-avatar" aria-hidden="true">@Display.Initials(Me.FullName)</span>
                            }
                            <span>
                                <span class="rd-name d-block">@Me.FullName</span>
                                <span class="rd-role d-block">@Me.Role</span>
                            </span>
                        </a>
                        <form asp-controller="Account" asp-action="Logout" method="post" class="m-0">
                            <button type="submit" class="btn btn-outline-light btn-sm"><i class="bi bi-box-arrow-right"></i> Log out</button>
                        </form>
                    }
                    else
                    {
                        <a class="btn btn-outline-light btn-sm" asp-controller="Account" asp-action="Login">Log in</a>
                        <a class="btn btn-primary btn-sm" asp-controller="Account" asp-action="Register">Register</a>
                    }
                </div>
            </div>
        </div>
    </nav>
</header>

<main>
    @if (TempData["Success"] is not null || TempData["Error"] is not null || TempData["Warning"] is not null)
    {
        <div class="container pt-3">
            <partial name="_Alerts" />
        </div>
    }
    @RenderBody()
</main>

<footer class="rd-footer">
    <div class="container d-flex flex-wrap justify-content-between gap-2">
        <span><strong>RaceDay</strong> &middot; Run, walk and cycle events</span>
        <span>PROG6212 Part 3</span>
    </div>
</footer>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
<script src="~/js/site.js" asp-append-version="true"></script>
@await RenderSectionAsync("Scripts", required: false)
</body>
</html>
