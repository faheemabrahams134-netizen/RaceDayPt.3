@if (TempData["Success"] is string success)
{
    <div class="rd-alert rd-alert-success mb-2" role="status"><i class="bi bi-check-circle-fill me-1"></i> @success</div>
}
@if (TempData["Error"] is string error)
{
    <div class="rd-alert rd-alert-error mb-2" role="alert"><i class="bi bi-exclamation-octagon-fill me-1"></i> @error</div>
}
@if (TempData["Warning"] is string warning)
{
    <div class="rd-alert rd-alert-warning mb-2" role="alert"><i class="bi bi-exclamation-triangle-fill me-1"></i> @warning</div>
}
