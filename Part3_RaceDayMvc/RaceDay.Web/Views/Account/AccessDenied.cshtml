@{
    ViewData["Title"] = "Access denied";
}
<div class="container rd-page">
    <div class="rd-card mx-auto text-center" style="max-width: 560px;">
        <div class="rd-card-body py-5">
            <i class="bi bi-slash-circle" style="font-size:3rem;color:var(--rd-primary)"></i>
            <h1 class="h2 mt-2">That page isn't for your account</h1>
            <p class="text-muted">Your role doesn't have access to this area. If you think that's wrong, log out and sign in with the right account.</p>
            <a class="btn btn-primary" asp-controller="Home" asp-action="Index">Back to home</a>
        </div>
    </div>
</div>
